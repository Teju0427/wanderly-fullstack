# Copy to .env for local development. In Azure, set these as
# App Service → Settings → Environment variables (never commit .env).

# Azure SQL Database
DB_SERVER=your-server-name.database.windows.net
DB_NAME=wanderly
DB_USER=wanderlyadmin
DB_PASSWORD=change-me
# DB_PORT=1433
# DB_ENCRYPT=true
# Set to true only when using a local SQL Server in Docker
# DB_TRUST_SERVER_CERTIFICATE=false

# Alternatively, one connection string instead of the five values above:
# AZURE_SQL_CONNECTION_STRING=Server=tcp:your-server.database.windows.net,1433;Database=wanderly;User Id=wanderlyadmin;Password=...;Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;

# Create tables + seed the catalog automatically on startup (default true)
DB_AUTO_MIGRATE=true

# Port for the Express server (Azure sets this automatically)
PORT=8080
